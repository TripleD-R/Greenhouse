<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="btn_rounded" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">#2C2727</item>
        <item name="colorPrimaryVariant">#141414</item>
        <item name="colorOnPrimary">@color/white</item>
    </style>

    <style name="btn_circle" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="android:background">@drawable/circle_button</item>
        <item name="android:tint">#FFFFFF</item>
        <item name="android:padding">12dp</item>
        <item name="android:elevation">4dp</item>
        <item name="cornerRadius">30dp</item>
    </style>

    <style name="slider_rounded" parent="Widget.MaterialComponents.Slider">
        <item name="trackColorActive">#2C2727</item>
        <item name="trackColorInactive">#BDBDBD</item>
        <item name="thumbColor">#2C2727</item>
        <item name="haloColor">#552C2727</item>
        <item name="thumbRadius">12dp</item>
        <item name="haloRadius">20dp</item>
        <item name="trackHeight">6dp</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Slider.Rounded</item>
    </style>


    <style name="ShapeAppearance.Slider.Rounded" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="SplashTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/background_splash</item>
    </style>
</resources>
